<mxfile host="app.diagrams.net" agent="analiticas-trace" version="24.7.17"><diagram id="actual" name="1. Actual (en memoria)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="actual-v1" value="Analíticas Trace · Almacenamiento actual (sin base de datos)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0b2545;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="actual-v2" value="&lt;b&gt;No hay base de datos.&lt;/b&gt; Cada puerto de salida tiene un adaptador en memoria.&lt;br&gt;Los datos &lt;b&gt;se pierden al reiniciar&lt;/b&gt; la aplicación. Cada carga de archivo &lt;b&gt;reemplaza&lt;/b&gt; la anterior.&lt;br&gt;Cambiar a una base de datos = escribir un adaptador nuevo por puerto (ver página 2)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#0f172a;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="900" height="70" as="geometry"/></mxCell><mxCell id="actual-v3" value="User  ·  auth.domain" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;rounded=1;arcSize=6;fillColor=#0b2545;strokeColor=#0b2545;fontColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="300" height="102" as="geometry"/></mxCell><mxCell id="actual-v4" value="InMemoryUserRepository → Map&lt;username, User&gt;" style="text;strokeColor=none;fillColor=#f1f5f9;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontStyle=2;fontColor=#475569;" vertex="1" parent="actual-v3"><mxGeometry x="0" y="30" width="300" height="24" as="geometry"/